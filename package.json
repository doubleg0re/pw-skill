{
  "name": "pw-skill",
  "version": "1.0.0",
  "description": "Playwright CLI Skill for Claude Code — persistent browser, modular skills, minimal tokens",
  "type": "module",
  "files": [
    "README.md",
    "bin",
    ".claude-plugin",
    "skills",
    "docs"
  ],
  "bin": {
    "pw": "./bin/pw.mjs",
    "pwi": "./bin/pwi.mjs"
  },
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "postinstall": "npx playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "playwright": "^1.51.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude-skill",
    "playwright",
    "browser-automation",
    "e2e",
    "cdp"
  ],
  "author": "doubleg0re",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/doubleg0re/pw-skill.git"
  }
}
